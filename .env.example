# Never commit .env, private keys, or data/assistant.
TELEGRAM_BOT_TOKEN=

# Somnia Shannon testnet (50312). These defaults need no changes.
RPC_URL=https://dream-rpc.somnia.network
WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
# Optional bytes32 venue id; all discovered markets are scoped to testnet tUSDC.
DREAMDEX_VENUE_ID=

ASSISTANT_DATA_DIR=./data/assistant
# Optional 64 hex characters. If blank, generate a local mode-0600 master key.
# Back up the key with assistant.sqlite. Never rotate without re-encryption.
WALLET_MASTER_KEY=

# Optional AI: choose one provider. Credentials never cross providers.
# One of: openai, openrouter, anoman, tokenkoding.
AI_PROVIDER=openai
# Anoman: use AI_PROVIDER=anoman with these server-side settings.
ANOMAN_API_KEY=
ANOMAN_MODEL=deepseek-v4-flash-latest
ANOMAN_BASE_URL=https://api.anoman.io/v1
# TokenKoding: use AI_PROVIDER=tokenkoding. OpenAI-compatible chat completions.
# This gateway rejects a request that disables reasoning, so the agent leaves
# the setting alone; it then reasons briefly and answers in a few seconds.
TOKENKODING_API_KEY=
TOKENKODING_MODEL=deepseek-v4-flash
TOKENKODING_BASE_URL=https://api.tokenkoding.id/v1
# OpenAI: set both fields to enable natural-language research.
OPENAI_API_KEY=
OPENAI_MODEL=
# OpenRouter: use AI_PROVIDER=openrouter. Set the model to a routed id from
# https://openrouter.ai/models — pick one that supports structured outputs,
# since the agent requires a strict JSON schema response.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional source-linked news for opportunity analysis.
SERPER_API_KEY=

# Request budgets, in milliseconds. Telegraf abandons a handler at
# HANDLER_TIMEOUT_MS, so the work inside one must always finish first:
# MARKET_TIMEOUT_MS + NEWS_TIMEOUT_MS + 2 x AI_TIMEOUT_MS < HANDLER_TIMEOUT_MS.
# The AI budget is per attempt; an unreadable reply is retried once.
AI_TIMEOUT_MS=30000
MARKET_TIMEOUT_MS=35000
NEWS_TIMEOUT_MS=5000
HANDLER_TIMEOUT_MS=150000

# Historical prototype only. The new bot does not use a shared PRIVATE_KEY.
PRIVATE_KEY=
HOUSE_ADDRESS=
DATA_PATH=./data/chronomancer.json
PORT=3000
